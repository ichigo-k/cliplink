{
  "expo": {
    "name": "ClipLink",
    "slug": "cliplink",
    "version": "0.1.24",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.cliplink.app",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_INSTALL_PACKAGES",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10251E"
      },
      "intentFilters": []
    },
    "plugins": [
      "./plugins/withNativeSources",
      "./plugins/withClipboardPackage",
      "./plugins/withBackgroundService",
      "./plugins/withShareActivity",
      "./plugins/withAccessibilityService",
      "./plugins/withNotificationListener",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22C55E"
        }
      ]
    ]
  }
}