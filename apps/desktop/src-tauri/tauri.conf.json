{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipLink",
  "version": "0.1.0",
  "identifier": "com.cliplink.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipLink",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "createUpdaterArtifacts": true },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMEQwMEFGODIzQjBCQUYKUldTdkN6dUNyd0FObm1icnliOFY2ck00Y3NpY0RmalBMQU5TMmg4VkFPNjRkUENIcnMrZklKZTEK",
      "endpoints": ["https://github.com/ichigo-k/cliplink/releases/latest/download/latest.json"]
    }
  }
}
